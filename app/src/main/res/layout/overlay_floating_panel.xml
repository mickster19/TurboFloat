<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_floating_panel"
    android:padding="10dp">

    <!-- Movable Drag Header -->
    <LinearLayout
        android:id="@+id/panelDragHeader"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="#162032"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/tvPanelTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TURBOFLOAT • WhatsApp"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPanelHide"
            android:layout_width="56dp"
            android:layout_height="30dp"
            android:backgroundTint="#334155"
            android:padding="0dp"
            android:text="FICHA"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Main HUD Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/panelDragHeader"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <!-- Live FPS & RAM Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="#0F172A"
            android:orientation="horizontal"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE FPS"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvHudFps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60 FPS"
                    android:textColor="#00E676"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RAM STATUS"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvHudRam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="45% Free"
                    android:textColor="#38BDF8"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btnHudBoost"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginBottom="6dp"
            android:backgroundTint="#10B981"
            android:text="BOOST RAM SASA (NO LAG)"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnLaunchFloatingApp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#00E5FF"
            android:text="FUNGUA WHATSAPP (FLOATING)"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Size Presets S / M / L -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="Ukubwa:"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnSizeS"
                android:layout_width="40dp"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#1E293B"
                android:padding="0dp"
                android:text="S"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnSizeM"
                android:layout_width="40dp"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#1E293B"
                android:padding="0dp"
                android:text="M"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnSizeL"
                android:layout_width="40dp"
                android:layout_height="30dp"
                android:backgroundTint="#1E293B"
                android:padding="0dp"
                android:text="L"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Opacity Slider -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mwonekano (Opacity):"
            android:textColor="#94A3B8"
            android:textSize="10sp" />

        <SeekBar
            android:id="@+id/seekPanelOpacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="92" />
    </LinearLayout>

    <!-- Bottom-Right Drag Resize Corner Handle -->
    <View
        android:id="@+id/viewResizeCorner"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:background="@drawable/ic_resize_corner" />

</RelativeLayout>
