<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F17"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TURBOFLOAT PRO"
            android:textColor="#00E5FF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Game Booster + Floating Overlay Eye HUD"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <!-- Step 1: Required Android Permissions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="1. RUHUSA MUHIMU (PERMISSIONS)"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Overlay Permission -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Display Over Other Apps"
                        android:textColor="#E2E8F0"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOverlayStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HAIJAWASHWA ✗"
                        android:textColor="#FF5252"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnPermOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="#00B8D4"
                    android:text="WASHA"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Usage Stats Permission -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Usage Access (RAM Booster)"
                        android:textColor="#E2E8F0"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvUsageStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HAIJAWASHWA ✗"
                        android:textColor="#FF5252"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnPermUsage"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="#1E293B"
                    android:text="RUHUSU"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- DND Permission -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gaming DND (Zuia Usumbufu)"
                        android:textColor="#E2E8F0"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDndStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HIARI (DND)"
                        android:textColor="#FFAB40"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnPermDnd"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="#1E293B"
                    android:text="RUHUSU"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Step 2: Select Target Overlay App -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="2. CHAGUA APP YA KU-OVERLAY JUU YA GAME"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgTargetApps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbWhatsapp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="WhatsApp"
                    android:textColor="#E2E8F0" />

                <RadioButton
                    android:id="@+id/rbTelegram"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Telegram"
                    android:textColor="#E2E8F0" />

                <RadioButton
                    android:id="@+id/rbYoutube"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="YouTube"
                    android:textColor="#E2E8F0" />

                <RadioButton
                    android:id="@+id/rbChrome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Google Chrome"
                    android:textColor="#E2E8F0" />
            </RadioGroup>

            <TextView
                android:id="@+id/tvSelectedApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="App Iliyochaguliwa: WhatsApp (com.whatsapp)"
                android:textColor="#00E5FF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Step 3: Game Booster Engine -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="3. GAME BOOSTER (SMOOTH GAMEPLAY)"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRamInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="RAM Inayotumika: Inapima..."
                android:textColor="#00E676"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/switchFreeform"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:checked="true"
                android:text="Freeform Floating Window (Fungua App kama dirisha dogo)"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <Switch
                android:id="@+id/switchDnd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:checked="true"
                android:text="Auto Gaming DND (Zuia lag ya notifications/calls)"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnBoostNow"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:backgroundTint="#10B981"
                android:text="SAFISHA RAM &amp; BOOST GAME SASA"
                android:textColor="#000000"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Start / Stop Overlay Buttons -->
        <Button
            android:id="@+id/btnStartOverlay"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#00E5FF"
            android:text="WASHA KA-ICON KA JICHO (START OVERLAY)"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnStopOverlay"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:backgroundTint="#334155"
            android:text="ZIMA OVERLAY"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
